<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="hm_pos_line_pricelist.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o_pricelist_button')]" position="after">
            <button t-if="pos.config.use_pricelist"
                    class="o_line_pricelist_button btn btn-secondary btn-lg py-5"
                    t-on-click="() => this.clickLinePricelist()">
                <i class="fa fa-tag me-2" role="img" aria-label="Tarifa de línea"/>
                Tarifa de línea
            </button>
        </xpath>
    </t>
</templates>
