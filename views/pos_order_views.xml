<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_order_form_line_pricelist" model="ir.ui.view">
        <field name="name">pos.order.form.line.pricelist</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lines']/list/field[@name='price_unit']" position="before">
                <field name="line_pricelist_id" readonly="1" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='lines']/form//field[@name='price_unit']" position="before">
                <field name="line_pricelist_id" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
